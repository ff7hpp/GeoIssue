# GeoIssue Server Environment Configuration

PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Neon / PostgreSQL Database URL
# Example: postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/geoissue?sslmode=require
DATABASE_URL=

# Deduplication matching threshold in meters
MATCH_RADIUS_METERS=50

# Nominatim Geocoding API timeout in milliseconds
GEOCODING_TIMEOUT=5000

# JWT signing secret — set a strong random value in production
JWT_SECRET=

# One-time admin bootstrap (used only by `npm run admin:create`)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=GeoIssue Administrator

# One-time password migration for an existing account; preserves role and reports
ACCOUNT_EMAIL=
ACCOUNT_PASSWORD=
