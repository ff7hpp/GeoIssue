    "account:set-password": "node src/db/set-user-password.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.13.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "vitest": "^5.0.0"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
