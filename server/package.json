{
  "name": "geoissue-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GeoIssue Express & Neon Backend",
  "main": "src/server.js",
  "scripts": {
    "build": "node --check src/server.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
