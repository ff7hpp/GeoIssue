{
  "name": "geoissue-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GeoIssue Express & Neon Backend",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "migrate": "tsx src/db/migrations.ts",
    "seed:dev": "tsx src/db/seed-development.ts"
  },
  "dependencies": {
